# Copy to .env.local and fill in. Never commit .env.local.
# Values come from the Supabase dashboard for project "nextlms2026-dev".

# Public (inlined into the browser bundle at build time) ----------------------
# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Base URL of this app (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — NEVER prefix with NEXT_PUBLIC_ ---------------------------------
# Project Settings → API Keys → Secret key (bypasses RLS)
SUPABASE_SECRET_KEY=sb_secret_xxx
# Connect → Transaction pooler (port 6543) — used by the app at runtime.
# Percent-encode special characters in the password (@ → %40, # → %23), or use a
# letters-and-numbers password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# OPTIONAL — migrations/scripts only, never needed on Vercel. If omitted, DATABASE_URL
# is used with port 5432 (Supabase session pooler: same host, user, password).
# DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
